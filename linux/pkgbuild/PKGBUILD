# Maintainer: RayoMD contributors
# Builds the working tree this file sits in: the repository is private, so there is no source to
# download. Run makepkg here (linux/pkgbuild) with the submodule checked out.
pkgname=rayomd-gui
pkgver=1.2.0
pkgrel=1
pkgdesc='RayoMD desktop app: write Markdown, see and export the PDF (Omarchy-native, Wayland)'
arch=('x86_64')
url='https://github.com/Butterski/rayomd-gui'
license=('Apache-2.0')
depends=('glibc' 'hicolor-icon-theme')
optdepends=('xdg-desktop-portal-gtk: system file dialogs'
            'ttf-liberation: preview of the standard PDF fonts'
            'ttf-jetbrains-mono-nerd: the Omarchy interface font')
makedepends=('cmake' 'git' 'python')
source=()
# The binary is stripped by its own link (-s): a debug package would be empty.
options=('!debug')

# The repository root, two levels above this file.
_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

build() {
  cd "$_root"
  # The assembly kernels get makepkg's CFLAGS too: with -fcf-protection they carry the IBT and
  # SHSTK property, and the executable keeps it.
  export ASMFLAGS="${ASMFLAGS:-$CFLAGS}"
  cmake --preset linux-release -B build/pkg -DBUILD_TESTING=OFF
  cmake --build build/pkg
}

package() {
  cd "$_root"
  install -Dm755 build/pkg/src/rayomd-gui "$pkgdir/usr/bin/rayomd-gui"
  install -Dm644 linux/rayomd-gui.desktop "$pkgdir/usr/share/applications/rayomd-gui.desktop"
  for size in 16 32 48 64 128 256; do
    install -Dm644 "linux/icons/hicolor/${size}x${size}/apps/rayomd-gui.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/rayomd-gui.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 third_party/omarchy/LICENSE "$pkgdir/usr/share/licenses/$pkgname/omarchy-LICENSE"
  install -Dm644 external/rayomd/third_party/tex-gyre/GUST-FONT-LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/GUST-FONT-LICENSE.txt"
}
